# Build-time settings for this checkout. Copy to .env.local (gitignored) and fill in what you need.
# Only HOMEBASE_* keys are read from .env.local (scripts/local-env.mjs, apps/client/app.config.js).
# Server settings (hub, connector, agents) go in ~/.config/homebase/homebase.env instead:
# see scripts/server/homebase.env.example and docs/CONFIGURATION.md.

# Android package name and Windows installer app id. Changing it makes a different app (pairing is per app).
HOMEBASE_APP_ID=dev.homebase.app
# Publisher shown in the desktop installer (author / copyright).
HOMEBASE_PUBLISHER=HomeBase contributors
# Default SSH host for scripts/deploy.sh (an alias from ~/.ssh/config, or user@host).
HOMEBASE_SSH_HOST=
