# Copied to ~/.config/homebase/homebase.env by install.sh. Read by the hub, the connector and `npm run pair-code`.
# No secrets belong here.

# Where the hub listens. Keep loopback and put `tailscale serve` in front of it.
# Fallback without tailscale serve: the machine's own tailnet IP (100.x.y.z). Never 0.0.0.0.
HOMEBASE_HOST=127.0.0.1
HOMEBASE_PORT=8787
HOMEBASE_DATA_DIR=~/homebase-data
# Printed at hub start so the log says which address phones use.
HOMEBASE_PUBLIC_URL=
# Do not mint or log pairing codes at boot; use `npm run pair-code`.
HOMEBASE_BOOT_CODES=0

# Connector
HB_HUB=http://127.0.0.1:8787
HB_CONNECTOR_CONFIG=~/homebase-data/connector.json
HB_CLAUDE_CONFIG=~/.config/homebase/claude-agent.json

# Notes agent and vault service (docs/NOTES-PLAN.md). The vault root is the folder with _Index.md and "Daily Notes";
# its git repository may be a parent folder. HB_NOTES=0 leaves the agent out.
HB_NOTES_VAULT=~/vault
# The owner's time zone: "today" for daily notes is computed here, never from the server's clock.
HB_NOTES_TZ=America/New_York

# Backup alerts (docs/CONFIGURATION.md#backup-alerts): on by themselves once backup.sh has written its status file.
# HB_BACKUP_ALERTS=auto
# HB_BACKUP_CHECK_MINUTES=10
# HB_BACKUP_STALE_HOURS=3

# The web client the hub serves at / (so a browser on the tailnet can open the hub's address and pair).
# Default: apps/client/dist in the deployed repo, shipped by scripts/deploy.sh from the PC's `npm run build:web`.
# Set a folder to serve another export, or "off" to answer / with the hub's JSON only.
# HOMEBASE_WEB_DIR=
