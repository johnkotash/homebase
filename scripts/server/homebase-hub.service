[Unit]
Description=HomeBase hub
After=network-online.target

[Service]
WorkingDirectory=%h/homebase
# Settings come from ~/.config/homebase/homebase.env, which the hub reads itself.
ExecStart=/usr/bin/env node --import tsx apps/server/src/index.ts
Restart=on-failure
RestartSec=3

[Install]
WantedBy=default.target
